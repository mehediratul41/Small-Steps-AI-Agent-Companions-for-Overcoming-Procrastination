# Local synthetic-data development only. Copy to .env; never commit .env.
APP_MODE=development
DATABASE_URL=sqlite:///./data/small_steps.db
AI_PROVIDER=mock
# To enable actual Google requests: AI_PROVIDER=gemini, then set both below.
GEMINI_API_KEY=
# Choose an available text model in AI Studio; pin its ID for your experiment.
GEMINI_MODEL=
CORS_ORIGINS=["http://127.0.0.1:8787","http://localhost:8787"]
PROTOCOL_VERSION=development-v1
CONSENT_VERSION=demo-consent-v1
TOKEN_TTL_DAYS=7
AI_REQUESTS_PER_HOUR=30

# Invite-only development account redemption; approved study enrollment remains disabled.
ACCOUNT_ENROLLMENT=true
